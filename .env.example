# URL pública do site (usada no metadataBase / Open Graph)
NEXT_PUBLIC_SITE_URL=https://kart.exemplo.com.br

# Álbum de fotos — Cloudflare R2
# Endpoint S3 do R2 (https://<account-id>.r2.cloudflarestorage.com)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Token R2 com "Object Read & Write" só no bucket do álbum
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nome do bucket
R2_BUCKET=kartamg
# URL pública do bucket (domínio próprio no Cloudflare), sem barra no final
NEXT_PUBLIC_FOTOS_URL=https://kartamg-bucket.db.app.br
# Código secreto para apagar fotos (só o Arthur)
FOTOS_ADMIN_TOKEN=
